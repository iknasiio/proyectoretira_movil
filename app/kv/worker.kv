#:import dp kivy.metrics.dp

<WorkerScreen>:
    MDBoxLayout:
        orientation: "vertical"
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(17), dp(14), dp(17), dp(20)
                spacing: dp(10)

                MDLabel:
                    text: "MI JORNADA"
                    size_hint_y: None
                    height: dp(22)
                    font_size: dp(14)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.secondary_text_color

                MDLabel:
                    text: "Servicios asignados"
                    size_hint_y: None
                    height: dp(34)
                    font_size: dp(22)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color

                MDLabel:
                    text: "Consulta la dirección y actualiza cada retiro al avanzar."
                    size_hint_y: None
                    height: dp(44)
                    font_size: dp(15)
                    theme_text_color: "Custom"
                    text_color: app.secondary_text_color
                    text_size: self.width, None
                    valign: "top"

                MDLabel:
                    id: worker_identity
                    text: "Trabajador"
                    size_hint_y: None
                    height: dp(32)
                    font_size: dp(16)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.accent_text_color

                MDCard:
                    style: "filled"
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(139)
                    padding: dp(12)
                    spacing: dp(5)
                    MDLabel:
                        id: route_count
                        text: "Ruta sugerida"
                        size_hint_y: None
                        height: dp(26)
                        font_size: dp(16)
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.accent_text_color
                    MDLabel:
                        text: "Orden por colonia y dirección; confirma las paradas en Maps."
                        size_hint_y: None
                        height: dp(35)
                        font_size: dp(14)
                        theme_text_color: "Custom"
                        text_color: app.secondary_text_color
                        text_size: self.width, None
                        valign: "top"
                    MDButton:
                        id: open_route
                        style: "filled"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(50)
                        on_release: app.open_worker_route()
                        MDButtonText:
                            text: "Abrir recorrido en Google Maps"
                            font_size: dp(14)

                MDLabel:
                    id: worker_count
                    text: "Servicios pendientes"
                    size_hint_y: None
                    height: dp(31)
                    font_size: dp(16)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color

                MDBoxLayout:
                    id: worker_requests
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
