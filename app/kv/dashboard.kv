#:import dp kivy.metrics.dp

<DashboardScreen>:
    MDBoxLayout:
        orientation: "vertical"
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(12), dp(10), dp(12), dp(14)
                spacing: dp(7)

                MDLabel:
                    text: "CENTRO DE OPERACIONES"
                    size_hint_y: None
                    height: dp(20)
                    font_size: dp(12)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.secondary_text_color

                MDLabel:
                    text: "Dashboard"
                    size_hint_y: None
                    height: dp(30)
                    font_size: dp(21)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color

                MDLabel:
                    text: "Monitorea solicitudes, equipo y actividad de la aplicación."
                    size_hint_y: None
                    height: dp(38)
                    font_size: dp(13)
                    theme_text_color: "Custom"
                    text_color: app.secondary_text_color
                    text_size: self.width, None
                    valign: "top"

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)

                    MDButton:
                        style: "tonal"
                        size_hint_x: 1
                        on_release: app.close_dashboard()
                        MDButtonText:
                            text: "Volver"
                            font_size: dp(12)

                    MDButton:
                        style: "tonal"
                        size_hint_x: 1
                        on_release: app.refresh_dashboard()
                        MDButtonText:
                            text: "Actualizar"
                            font_size: dp(12)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(6)

                    MDButton:
                        id: period_today
                        style: "tonal"
                        size_hint_x: 1
                        on_release: app.set_dashboard_period(1)
                        MDButtonText:
                            text: "Hoy"
                            font_size: dp(12)

                    MDButton:
                        id: period_week
                        style: "filled"
                        size_hint_x: 1
                        on_release: app.set_dashboard_period(7)
                        MDButtonText:
                            text: "7 días"
                            font_size: dp(12)

                    MDButton:
                        id: period_month
                        style: "tonal"
                        size_hint_x: 1
                        on_release: app.set_dashboard_period(30)
                        MDButtonText:
                            text: "30 días"
                            font_size: dp(12)

                MDLabel:
                    id: dashboard_data_status
                    text: "SIMULACIÓN · registros ficticios"
                    size_hint_y: None
                    height: dp(30)
                    font_size: dp(10)
                    theme_text_color: "Custom"
                    text_color: app.secondary_text_color
                    text_size: self.width, None
                    valign: "middle"

                MDBoxLayout:
                    id: dashboard_content
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
